<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mapping export Omeka → MODS (Metadata Object Description Schema).

    Approche en deux couches :
    1. Les <maps> projettent les propriétés Omeka dans un wrapper DC
       intermédiaire (<dc-pivot>...</dc-pivot>) lisible et facile à
       construire par accumulation de paths.
    2. Le <postprocess> applique un XSL qui restructure ce DC pivot vers
       MODS (titleInfo, name, originInfo, subject, etc.).

    Cette séparation isole la sélection des propriétés (déclaratif INI/XML)
    de la structuration finale (XSLT, plus adapté aux schémas riches).

    Référence MODS :
    @link https://www.loc.gov/standards/mods/v3/mods-3-7.xsd

    @copyright Daniel Berthereau, 2026
    @license CeCILL 2.1 https://cecill.info/licences/Licence_CeCILL_V2.1-fr.txt
-->

<mapping>

    <info>
        <label>Omeka to MODS</label>
        <from>resources</from>
        <to>mods</to>
        <querier>omeka</querier>
        <postprocess>module:mods/omeka_to_mods.xsl</postprocess>
    </info>

    <params>
        <param name="xmlns.dc">http://purl.org/dc/elements/1.1/</param>
        <param name="xmlns.dcp">urn:omeka-mapper:dc-pivot</param>
    </params>

    <maps>

        <map>
            <from path="dcterms:title"/>
            <to field="/dcp:dc-pivot/dc:title"/>
        </map>

        <map>
            <from path="dcterms:creator"/>
            <to field="/dcp:dc-pivot/dc:creator"/>
        </map>

        <map>
            <from path="dcterms:contributor"/>
            <to field="/dcp:dc-pivot/dc:contributor"/>
        </map>

        <map>
            <from path="dcterms:subject"/>
            <to field="/dcp:dc-pivot/dc:subject"/>
        </map>

        <map>
            <from path="dcterms:description"/>
            <to field="/dcp:dc-pivot/dc:description"/>
        </map>

        <map>
            <from path="dcterms:publisher"/>
            <to field="/dcp:dc-pivot/dc:publisher"/>
        </map>

        <map>
            <from path="dcterms:date"/>
            <to field="/dcp:dc-pivot/dc:date"/>
        </map>

        <map>
            <from path="dcterms:type"/>
            <to field="/dcp:dc-pivot/dc:type"/>
        </map>

        <map>
            <from path="dcterms:language"/>
            <to field="/dcp:dc-pivot/dc:language"/>
        </map>

        <map>
            <from path="dcterms:rights"/>
            <to field="/dcp:dc-pivot/dc:rights"/>
        </map>

        <map>
            <from path="dcterms:identifier"/>
            <to field="/dcp:dc-pivot/dc:identifier"/>
        </map>

    </maps>

</mapping>
