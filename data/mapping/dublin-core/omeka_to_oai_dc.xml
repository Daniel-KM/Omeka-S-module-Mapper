<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mapping export Omeka → OAI-DC.

    Sérialise une ressource Omeka au format Dublin Core simple, dans le
    wrapper OAI-PMH. Chaque élément Dublin Core simple reçoit le terme dcterms
    de base ainsi que ses raffinements, selon le « dumb-down » recommandé par
    le DCMI (ex. dcterms:created, dcterms:modified, dcterms:issued… sont tous
    projetés dans dc:date).

    Référence :
    @link https://www.openarchives.org/OAI/openarchivesprotocol.html#dublincore
    @link https://www.openarchives.org/OAI/2.0/oai_dc.xsd
    @link https://www.dublincore.org/specifications/dublin-core/dcmi-terms/

    @copyright Daniel Berthereau, 2026
    @license CeCILL 2.1 https://cecill.info/licences/Licence_CeCILL_V2.1-fr.txt
-->

<mapping>

    <info>
        <label>Omeka to OAI-DC</label>
        <from>resources</from>
        <to>oai_dc</to>
        <querier>omeka</querier>
    </info>

    <params>
        <param name="xmlns.oai_dc">http://www.openarchives.org/OAI/2.0/oai_dc/</param>
        <param name="xmlns.dc">http://purl.org/dc/elements/1.1/</param>
        <param name="xmlns.xsi">http://www.w3.org/2001/XMLSchema-instance</param>
    </params>

    <maps>

        <!-- The 15 Dublin Core elements, base term first then its dcterms
             refinements (DCMI dumb-down), in the order recommended by OAI-PMH. -->

        <!-- title ← title, alternative -->
        <map><from path="dcterms:title"/>             <to field="/oai_dc:dc/dc:title"/></map>
        <map><from path="dcterms:alternative"/>       <to field="/oai_dc:dc/dc:title"/></map>

        <!-- creator -->
        <map><from path="dcterms:creator"/>           <to field="/oai_dc:dc/dc:creator"/></map>

        <!-- subject -->
        <map><from path="dcterms:subject"/>           <to field="/oai_dc:dc/dc:subject"/></map>

        <!-- description ← description, abstract, tableOfContents, provenance.
             provenance has no simple-DC parent in the DCMI dumb-down; it holds
             descriptive custody/source statements, so it is exposed here as a
             descriptive note rather than dropped. -->
        <map><from path="dcterms:description"/>       <to field="/oai_dc:dc/dc:description"/></map>
        <map><from path="dcterms:abstract"/>          <to field="/oai_dc:dc/dc:description"/></map>
        <map><from path="dcterms:tableOfContents"/>   <to field="/oai_dc:dc/dc:description"/></map>
        <map><from path="dcterms:provenance"/>        <to field="/oai_dc:dc/dc:description"/></map>

        <!-- publisher -->
        <map><from path="dcterms:publisher"/>         <to field="/oai_dc:dc/dc:publisher"/></map>

        <!-- contributor -->
        <map><from path="dcterms:contributor"/>       <to field="/oai_dc:dc/dc:contributor"/></map>

        <!-- date ← date, created, issued, modified, available, valid,
             dateAccepted, dateCopyrighted, dateSubmitted -->
        <map><from path="dcterms:date"/>              <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:created"/>           <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:issued"/>            <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:modified"/>          <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:available"/>         <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:valid"/>             <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:dateAccepted"/>      <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:dateCopyrighted"/>   <to field="/oai_dc:dc/dc:date"/></map>
        <map><from path="dcterms:dateSubmitted"/>     <to field="/oai_dc:dc/dc:date"/></map>

        <!-- type -->
        <map><from path="dcterms:type"/>              <to field="/oai_dc:dc/dc:type"/></map>

        <!-- format ← format, extent, medium -->
        <map><from path="dcterms:format"/>            <to field="/oai_dc:dc/dc:format"/></map>
        <map><from path="dcterms:extent"/>            <to field="/oai_dc:dc/dc:format"/></map>
        <map><from path="dcterms:medium"/>            <to field="/oai_dc:dc/dc:format"/></map>

        <!-- identifier ← identifier, bibliographicCitation -->
        <map><from path="dcterms:identifier"/>            <to field="/oai_dc:dc/dc:identifier"/></map>
        <map><from path="dcterms:bibliographicCitation"/> <to field="/oai_dc:dc/dc:identifier"/></map>

        <!-- source -->
        <map><from path="dcterms:source"/>            <to field="/oai_dc:dc/dc:source"/></map>

        <!-- language -->
        <map><from path="dcterms:language"/>          <to field="/oai_dc:dc/dc:language"/></map>

        <!-- relation ← relation, conformsTo, hasFormat, hasPart, hasVersion,
             isFormatOf, isPartOf, isReferencedBy, isReplacedBy, isRequiredBy,
             isVersionOf, references, replaces, requires -->
        <map><from path="dcterms:relation"/>          <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:conformsTo"/>        <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:hasFormat"/>         <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:hasPart"/>           <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:hasVersion"/>        <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isFormatOf"/>        <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isPartOf"/>          <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isReferencedBy"/>    <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isReplacedBy"/>      <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isRequiredBy"/>      <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:isVersionOf"/>       <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:references"/>        <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:replaces"/>          <to field="/oai_dc:dc/dc:relation"/></map>
        <map><from path="dcterms:requires"/>          <to field="/oai_dc:dc/dc:relation"/></map>

        <!-- coverage ← coverage, spatial, temporal -->
        <map><from path="dcterms:coverage"/>          <to field="/oai_dc:dc/dc:coverage"/></map>
        <map><from path="dcterms:spatial"/>           <to field="/oai_dc:dc/dc:coverage"/></map>
        <map><from path="dcterms:temporal"/>          <to field="/oai_dc:dc/dc:coverage"/></map>

        <!-- rights ← rights, accessRights, license -->
        <map><from path="dcterms:rights"/>            <to field="/oai_dc:dc/dc:rights"/></map>
        <map><from path="dcterms:accessRights"/>      <to field="/oai_dc:dc/dc:rights"/></map>
        <map><from path="dcterms:license"/>           <to field="/oai_dc:dc/dc:rights"/></map>

    </maps>

</mapping>
